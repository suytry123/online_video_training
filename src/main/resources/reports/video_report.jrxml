<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="video_report" pageWidth="595" pageHeight="842"
    columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <field name="videoId" class="java.lang.Long"/>
    <field name="title" class="java.lang.String"/>
    <field name="courseName" class="java.lang.String"/>
    <field name="linkCount" class="java.lang.Integer"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Video Report]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="80" height="25"/><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="80" y="0" width="200" height="25"/><text><![CDATA[Title]]></text></staticText>
            <staticText><reportElement x="280" y="0" width="150" height="25"/><text><![CDATA[Course]]></text></staticText>
            <staticText><reportElement x="430" y="0" width="100" height="25"/><text><![CDATA[Links]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{videoId}]]></textFieldExpression></textField>
            <textField><reportElement x="80" y="0" width="200" height="20"/><textFieldExpression><![CDATA[$F{title}]]></textFieldExpression></textField>
            <textField><reportElement x="280" y="0" width="150" height="20"/><textFieldExpression><![CDATA[$F{courseName}]]></textFieldExpression></textField>
            <textField><reportElement x="430" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{linkCount}]]></textFieldExpression></textField>
        </band>
    </detail>

</jasperReport>